venv/
__pycache__/
*.pyc
runs/
.chroma/
config.json
.superpowers/

# outputs of a sedimentation run: the seeded store (embeddings, hundreds of
# MB) and the run's own statistics. Regenerated by experiments/sediment_all.py
scenarios/*.yaml.ltm.json
scenarios/*.yaml.ltm.en.json
scenarios/*.sediment_stats.json
config_flash.json

# generated continuation scenarios (per-method, from run_continue.py)
scenarios/*.cont_*.sim.yaml

# Everything a run produces stays out of the repository: stores, checkpoints,
# event logs, statistics, scored results and generated figures. The repository
# carries the method -- code, scenarios, source texts -- and the built paper.
# See REPRODUCE.md for how to regenerate the data from scratch.
